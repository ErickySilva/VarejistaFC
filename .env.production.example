# Variáveis de PRODUÇÃO. Modelo: só nomes e valores de exemplo.
#
# Na máquina de produção, copie para `.env.production`, preencha e proteja:
#   cp .env.production.example .env.production && chmod 600 .env.production
# O `.env.production` nunca é versionado nem copiado para a imagem.
#
# Não reaproveite nenhum valor do ambiente de desenvolvimento.

# --- PostgreSQL ---
POSTGRES_USER=varejista_prod
POSTGRES_DB=varejista
# Senha do banco. Use só letras e números (ela entra em uma URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_GERADA

# --- Autenticação (Better Auth) ---
# Chave que assina os cookies de sessão. Gere uma só para produção:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BETTER_AUTH_SECRET=TROQUE_POR_UM_SEGREDO_GERADO_COM_32_OU_MAIS_CARACTERES
# Endereço público do site, exatamente como o visitante digita. Com HTTPS
# configurado: https://SEU_DOMINIO
BETTER_AUTH_URL=https://SEU_DOMINIO

# --- Stack ---
# Porta HTTP publicada pelo Nginx no host.
HTTP_PORT=80
# Versão da imagem (ex.: o hash curto do commit). Permite voltar para a
# anterior sem reconstruir.
APP_VERSION=latest
