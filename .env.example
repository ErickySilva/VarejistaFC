# Copie para .env e ajuste. O .env nunca é versionado.

# Banco usado pela aplicação rodando na sua máquina (Postgres do compose.yaml).
DATABASE_URL=postgres://varejista:varejista@localhost:5432/varejista

# Credenciais do Postgres de desenvolvimento (lidas pelo compose.yaml).
POSTGRES_USER=varejista
POSTGRES_PASSWORD=varejista
POSTGRES_DB=varejista
POSTGRES_PORT=5432

# Autenticação (Better Auth).
# Chave que assina os cookies de sessão: gere uma própria e nunca a versione.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Endereço pelo qual a aplicação é acessada.
BETTER_AUTH_URL=http://localhost:3000
